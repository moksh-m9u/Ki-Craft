# Copy to .env and fill in the values. Write them without quotes:
# docker run --env-file keeps quotes as part of the value.
# Defaults for everything else are in config/settings.py.

# Required: answers (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Required: embeddings on IBM watsonx.ai, for every question and every chunk.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://eu-de.ml.cloud.ibm.com

# Ingestion with the default Hugging Face summary backend
# (https://huggingface.co/settings/tokens).
HF_TOKEN=

# Postgres on Neon (Connect dialog of the branch). DATABASE_URL is the pooled
# string (host contains -pooler); DATABASE_URL_DIRECT is the same string
# without -pooler, used by Alembic migrations and bulk copies.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Optional: the production branch's direct string (without -pooler). Only
# scripts/copy_document.py reads it, to copy documents from dev to production.
# PRODUCTION_DATABASE_URL_DIRECT=

# Optional: LangSmith tracing. Leave LANGSMITH_TRACING=false to run without it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=multimodal-rag

# Optional: where the dashboard finds the API (default http://localhost:8000).
# API_BASE_URL=http://127.0.0.1:8001

# Optional: browser origins allowed to call the API, comma-separated.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: ingestion summary backend, huggingface (default) or local.
# ENHANCEMENT_BACKEND=local
