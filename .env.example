# Copy to .env and fill in the values. Write them without quotes:
# docker run --env-file keeps quotes as part of the value.
# Defaults for everything else are in config/settings.py.

# Required: answers (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Embeddings: pick one backend. Each embedding model has its own collection in
# the store (see CONTRIBUTING.md, "Choosing an embedding backend").
#   openrouter  any OpenRouter embedding model; the default is free and needs
#               no credit card (https://openrouter.ai/settings/keys)
#   watsonx     IBM Granite, the original store; used when EMBEDDING_BACKEND is unset
#   local       the same Granite model as a GGUF file run by llama.cpp (needs
#               `uv sync --extra local-embeddings` and the model file; not in
#               the API Docker image)
# API backends send every question, and at ingestion every summary, to the provider.
EMBEDDING_BACKEND=openrouter

OPENROUTER_API_KEY=
# OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://eu-de.ml.cloud.ibm.com

# LOCAL_EMBEDDING_GGUF_PATH=models/granite-embedding-278m-multilingual-Q8_0.gguf
# LOCAL_EMBEDDING_THREADS=1

# Ingestion with the default Hugging Face summary backend
# (https://huggingface.co/settings/tokens).
HF_TOKEN=

# Optional: LangSmith tracing. Leave LANGSMITH_TRACING=false to run without it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=multimodal-rag

# Optional: where the dashboard finds the API (default http://localhost:8000).
# API_BASE_URL=http://127.0.0.1:8001

# Optional: browser origins allowed to call the API, comma-separated.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: ingestion summary backend, huggingface (default) or local.
# ENHANCEMENT_BACKEND=local
